extract_doc_speeches(xml_docs[[i]], doc_id = i)
}) %>% bind_rows()
extract_doc_speeches <- function(doc) {
speech_nodes <- xml_find_all(doc, ".//*[local-name()='speech']")
lapply(speech_nodes, extract_speech, doc = doc) %>% bind_rows()
}
extract_doc_speeches <- function(doc) {
speech_nodes <- xml_find_all(doc, ".//*[local-name()='speech']")
lapply(speech_nodes, extract_speech, doc = doc) %>% bind_rows()
}
extract_doc_speeches <- function(doc) {
speech_nodes <- xml_find_all(doc, ".//*[local-name()='speech']")
