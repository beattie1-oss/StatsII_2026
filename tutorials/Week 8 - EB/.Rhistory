# load data
gdp_data <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsII_2026/main/datasets/gdpChange.csv", stringsAsFactors = F)
gdp_data <- gdp_data %>%
mutate(
GDPWdiff_cat = case_when(
GDPWdiff > 0 ~ "Positive",
GDPWdiff < 0 ~ "Negative",
TRUE ~ "No Change"
),
GDPWdiff_cat = factor(GDPWdiff_cat, levels = c("No Change", "Positive", "Negative"))
)
# Unordered Multinomial Logit
unordered_log <- multinom(GDPWdiff_cat ~ REG + OIL, data = gdp_data)
summary(unordered_log )
stargazer(unordered_log ,
type = "latex", #output code for use in latex
title = "Unordered Multinomial Logit",
covariate.labels = c("Democracy", "Dominant Oil Exporter"),
dep.var.caption = "DV")
# Ordered Multinomial Logit
ordered_log <- polr(GDPWdiff_cat ~ REG + OIL, data = gdp_data, Hess = TRUE)
summary(ordered_log)
stargazer(ordered_log,
type = "latex", #output code for use in latex
title = "Ordered Multinomial Logit",
covariate.labels = c("Democracy", "Dominant Oil Exporter"),
dep.var.caption = "DV")
# Unordered Multinomial Logit
levels(GDPWdiff_cat)
# Unordered Multinomial Logit
levels(gdp_data$GDPWdiff_cat)
summary(unordered_log)
exp(coef(unordered_log))
z <- summary(mult.log)$coefficients/summary(mult.log)$standard.errors
z <- summary(unordered_log)$coefficients/summary(unordered_log)$standard.errors
(p <- (1 - pnorm(abs(z), 0, 1)) * 2)
pp <- data.frame(fitted(mult.log))
pp <- data.frame(fitted(unordered_log))
pp
coefs <- summary(unordered_log)$coefficients
se <- summary(unordered_log)$standard.errors
z <- coefs/se
p <- (1-pnorm(abs(z))) * 2
odds_ratios <- exp(coefs)
results <- cbind(odds_ratios,ses,z,p)
results <- cbind(odds_ratios,se,z,p)
results
